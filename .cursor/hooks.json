{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/guard-env.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/check-on-stop.mjs",
        "timeout": 180,
        "loop_limit": 3
      }
    ]
  }
}
